# ── Modo mock (desarrollo sin hardware) ─────────────────────────────────────
# NEXT_PUBLIC_USE_MOCK=true   ← datos de demo, no necesita backend
# NEXT_PUBLIC_USE_MOCK=false  ← datos reales del backend Flask + PostgreSQL

NEXT_PUBLIC_USE_MOCK=false

# URL del backend Flask (Arduino Uno Q en la misma red local)
# Cambia la IP si el Arduino Uno Q tiene una IP fija distinta.
NEXT_PUBLIC_API_BASE=http://localhost:8000
